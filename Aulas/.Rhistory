# Simular 2 réplicas do experimento de cerâmica
simular_replicas <- function(t = 3, r = 2) {
dados <- data.frame()
for (rep in 1:r) {
# Design diferente para cada réplica
design <- matrix(sample(1:t), nrow = t)
for (i in 1:t) {
design[, i] <- sample(design[, i])
}
# Efeitos (podem variar entre réplicas)
mu_rep <- 50 + rnorm(1, 0, 2)  # Média varia
for (i in 1:t) {
for (j in 1:t) {
k <- design[i, j]
y <- mu_rep +
rnorm(1, c(-5, 0, 5)[i], 1) +  # Efeito linha
rnorm(1, c(-3, 0, 3)[j], 1) +  # Efeito coluna
rnorm(1, c(-8, 0, 8)[k], 1) +  # Efeito tratamento
rnorm(1, 0, 2)  # Erro
dados <- rbind(dados,
data.frame(Replica = factor(rep),
Fornecedor = factor(i, labels = c("Q1", "Q2", "Q3")),
Forno = factor(j, labels = c("F1", "F2", "F3")),
Processo = factor(k, labels = c("A", "B", "C")),
Resistencia = y))
}
}
}
return(dados)
}
set.seed(789)
dados_replicas <- simular_replicas(3, 2)
t=3
design <- matrix(sample(1:t), nrow = t)
