# Carregar pacotes necessários
library(ggplot2)
library(dplyr)
library(MASS) # Para a função ginv()
library(DiagrammeR)
library(sf)
library(tidyverse)
library(agricolae)
library(plotly)
# Teste de Scott-Knott
# Instalar se necessário: install.packages("ScottKnott")
library(ScottKnott)
install.packages(c("tkrplot", "tkRplotR"))
# Teste de Tukey HSD
tukey_result <- TukeyHSD(modelo_ceramica, "Processo", conf.level = 0.95)
# Parâmetros verdadeiros (desconhecidos na prática)
mu <- 50          # Média geral (MPa)
rho <- c(-5, 0, 5)       # Efeito dos fornecedores
gamma <- c(-3, 0, 3)     # Efeito dos fornos
# Parâmetros verdadeiros (desconhecidos na prática)
mu <- 50          # Média geral (MPa)
rho <- c(-5, 0, 5)       # Efeito dos fornecedores
gamma <- c(-3, 0, 3)     # Efeito dos fornos
tau <- c(-8, 0, 8)       # Efeito dos processos
sigma <- 2        # Desvio padrão do erro
# Design fixo (para exemplo didático)
design <- matrix(c(1, 2, 3,
3, 1, 2,
2, 3, 1), nrow = 3)
# Criar estrutura de dados
dados_ceramica <- expand.grid(
Fornecedor = factor(1:3, labels = c("Q1", "Q2", "Q3")),
Forno = factor(1:3, labels = c("F1", "F2", "F3"))
)
# Atribuir tratamentos conforme o design
dados_ceramica$Processo <- factor(apply(dados_ceramica, 1, function(x) {
i <- as.numeric(sub("Q", "", x[1]))
j <- as.numeric(sub("F", "", x[2]))
design[i, j]
}), labels = c("A", "B", "C"))
# Simular resistências
set.seed(456)
for (i in 1:nrow(dados_ceramica)) {
fornecedor <- as.numeric(dados_ceramica$Fornecedor[i])
forno <- as.numeric(dados_ceramica$Forno[i])
processo <- as.numeric(dados_ceramica$Processo[i])
# Modelo: Y = μ + ρ_i + γ_j + τ_k + ε
dados_ceramica$Resistencia[i] <- mu +
rho[fornecedor] +
gamma[forno] +
tau[processo] +
rnorm(1, 0, sigma)
}
cat("Dados do experimento de cerâmica:\n")
print(dados_ceramica)
# Modelo ANOVA
modelo_ceramica <- aov(Resistencia ~ Fornecedor + Forno + Processo,
data = dados_ceramica)
# Tabela ANOVA detalhada
anova_result <- summary(modelo_ceramica)
cat("ANOVA para o experimento de cerâmica:\n")
print(anova_result)
# Extrair estatísticas importantes
F_trat <- anova_result[[1]]$"F value"[3]
p_trat <- anova_result[[1]]$"Pr(>F)"[3]
df_trat <- anova_result[[1]]$"Df"[3]
df_res <- anova_result[[1]]$"Df"[4]
# Cálculo do tamanho de efeito (η²)
SS_trat <- anova_result[[1]]$"Sum Sq"[3]
SS_total <- sum(anova_result[[1]]$"Sum Sq")
eta_squared <- SS_trat / SS_total
cat("\nEstatísticas adicionais:\n")
cat(sprintf("F(%d, %d) para tratamentos = %.4f\n", df_trat, df_res, F_trat))
cat(sprintf("Valor-p para tratamentos = %.4f\n", p_trat))
cat(sprintf("Eta quadrado (η²) = %.4f\n", eta_squared))
alpha <- 0.05
# Interpretação para tratamentos
cat("1. TESTE PARA PROCESSOS DE PRODUÇÃO:\n")
cat(sprintf("   F(%d, %d) = %.4f, p = %.4f\n", df_trat, df_res, F_trat, p_trat))
if (p_trat < alpha) {
cat("   DECISÃO: Rejeita-se H₀ a", alpha*100, "% de significância.\n")
cat("   CONCLUSÃO: Há evidência estatística de diferença entre os processos.\n")
# Tamanho do efeito
if (eta_squared < 0.01) {
cat("   TAMANHO DO EFEITO: Muito pequeno (η² < 0.01)\n")
} else if (eta_squared < 0.06) {
cat("   TAMANHO DO EFEITO: Pequeno (0.01 ≤ η² < 0.06)\n")
} else if (eta_squared < 0.14) {
cat("   TAMANHO DO EFEITO: Médio (0.06 ≤ η² < 0.14)\n")
} else {
cat("   TAMANHO DO EFEITO: Grande (η² ≥ 0.14)\n")
}
} else {
cat("   DECISÃO: Não se rejeita H₀ a", alpha*100, "% de significância.\n")
cat("   CONCLUSÃO: Não há evidência de diferença entre os processos.\n")
}
# Tamanho do efeito
if (eta_squared < 0.01) {
cat("   TAMANHO DO EFEITO: Muito pequeno (η² < 0.01)\n")
} else if (eta_squared < 0.06) {
cat("   TAMANHO DO EFEITO: Pequeno (0.01 ≤ η² < 0.06)\n")
} else if (eta_squared < 0.14) {
cat("   TAMANHO DO EFEITO: Médio (0.06 ≤ η² < 0.14)\n")
} else {
cat("   TAMANHO DO EFEITO: Grande (η² ≥ 0.14)\n")
}
} else {
# Interpretação para tratamentos
cat("1. TESTE PARA PROCESSOS DE PRODUÇÃO:\n")
cat(sprintf("   F(%d, %d) = %.4f, p = %.4f\n", df_trat, df_res, F_trat, p_trat))
if (p_trat < alpha) {
cat("   DECISÃO: Rejeita-se H₀ a", alpha*100, "% de significância.\n")
cat("   CONCLUSÃO: Há evidência estatística de diferença entre os processos.\n")
# Tamanho do efeito
if (eta_squared < 0.01) {
cat("   TAMANHO DO EFEITO: Muito pequeno (η² < 0.01)\n")
} else if (eta_squared < 0.06) {
cat("   TAMANHO DO EFEITO: Pequeno (0.01 ≤ η² < 0.06)\n")
} else if (eta_squared < 0.14) {
cat("   TAMANHO DO EFEITO: Médio (0.06 ≤ η² < 0.14)\n")
} else {
cat("   TAMANHO DO EFEITO: Grande (η² ≥ 0.14)\n")
}
} else {
cat("   DECISÃO: Não se rejeita H₀ a", alpha*100, "% de significância.\n")
cat("   CONCLUSÃO: Não há evidência de diferença entre os processos.\n")
}
# Interpretação para fatores de bloqueio
cat("\n2. EFICÁCIA DO BLOQUEIO:\n")
p_fornecedor <- anova_result[[1]]$"Pr(>F)"[1]; p_forno <- anova_result[[1]]$"Pr(>F)"[2]
cat(sprintf("   Fornecedor: p = %.4f", p_fornecedor))
if (p_fornecedor < alpha) {
cat(" → Bloqueio EFICAZ (diferenças significativas entre fornecedores)\n")
} else {
cat(" → Bloqueio POUCO EFICAZ (fornecedores similares)\n")
}
cat(sprintf("   Forno: p = %.4f", p_forno))
if (p_forno < alpha) {
cat(" → Bloqueio EFICAZ (diferenças significativas entre fornos)\n")
} else {
cat(" → Bloqueio POUCO EFICAZ (fornos similares)\n")
}
# Teste de Tukey HSD
tukey_result <- TukeyHSD(modelo_ceramica, "Processo", conf.level = 0.95)
cat("COMPARAÇÕES MÚLTIPLAS (Tukey HSD, 95% de confiança):\n")
cat("====================================================\n\n")
print(tukey_result$Processo)
# Interpretação
cat("\nINTERPRETAÇÃO:\n")
diferencias <- tukey_result$Processo
for (i in 1:nrow(diferencias)) {
comp <- rownames(diferencias)[i]
diff <- diferencias[i, "diff"]
p_val <- diferencias[i, "p adj"]
lwr <- diferencias[i, "lwr"]
upr <- diferencias[i, "upr"]
cat(sprintf("\n%s:", comp))
cat(sprintf("\n  Diferença = %.2f MPa", diff))
cat(sprintf("\n  IC 95%% = [%.2f, %.2f]", lwr, upr))
cat(sprintf("\n  p ajustado = %.4f", p_val))
if (p_val < 0.05) {
cat(" → Diferença SIGNIFICATIVA\n")
} else {
cat(" → Diferença NÃO SIGNIFICATIVA\n")
}
}
# Gráfico dos intervalos de confiança
par(mar = c(5, 8, 4, 2))
plot(tukey_result, las = 1, main = "Comparações de Tukey para Processos")
plot(tukey_result)
plot(tukey_result)
plot(tukey_result, las = 1, main = "Comparações de Tukey para Processos")
plot(tukey_result,  main = "Comparações de Tukey para Processos")
# Gráfico dos intervalos de confiança
par(mar = c(5, 8, 4, 2))
plot(tukey_result)
abline(v = 0, col = "red", lty = 2)
dev.off()
