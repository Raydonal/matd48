install.packages("lmtest", repos = "http://cran.us.r-project.org")
library(lmtest)
}
bp_test <- bptest(modelo_ceramica)
cat("\n2. HOMOCEDASTICIDADE (Breusch-Pagan):\n")
cat(sprintf("   BP = %.4f, p = %.4f\n",
bp_test$statistic, bp_test$p.value))
if (bp_test$p.value < 0.05) {
cat("   → Rejeita-se homocedasticidade (p < 0.05)\n")
cat("   IMPLICAÇÃO: Variâncias não são constantes\n")
} else {
cat("   → Não se rejeita homocedasticidade (p ≥ 0.05)\n")
cat("   IMPLICAÇÃO: Pressuposto satisfeito\n")
}
